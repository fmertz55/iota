{
  "spec_version": "0.1-draft",
  "log_base": 2,
  "arm_orientation": {
    "p": "natural_or_interaction_present",
    "q": "matched_reference"
  },
  "absolute_tolerance": 1e-12,
  "cases": [
    {
      "id": "no_interaction",
      "labels": ["y0", "y1"],
      "p": [0.5, 0.5],
      "q": [0.5, 0.5],
      "expected": {"i_icp_bits": 0.0, "delta_h_icp_bits": 0.0}
    },
    {
      "id": "same_deterministic_future",
      "labels": ["y0", "y1"],
      "p": [1.0, 0.0],
      "q": [1.0, 0.0],
      "expected": {"i_icp_bits": 0.0, "delta_h_icp_bits": 0.0}
    },
    {
      "id": "deterministic_redirection",
      "labels": ["y0", "y1"],
      "p": [1.0, 0.0],
      "q": [0.0, 1.0],
      "expected": {"i_icp_bits": 1.0, "delta_h_icp_bits": 0.0}
    },
    {
      "id": "strict_support_reduction",
      "labels": ["y0", "y1"],
      "p": [1.0, 0.0],
      "q": [0.5, 0.5],
      "expected": {"i_icp_bits": 0.311278124459133, "delta_h_icp_bits": 1.0}
    },
    {
      "id": "equal_support_reshaping",
      "labels": ["y0", "y1"],
      "p": [0.9, 0.1],
      "q": [0.5, 0.5],
      "expected": {"i_icp_bits": 0.146793102436052, "delta_h_icp_bits": 0.531004406410719}
    },
    {
      "id": "support_expansion",
      "labels": ["y0", "y1"],
      "p": [0.5, 0.5],
      "q": [1.0, 0.0],
      "expected": {"i_icp_bits": 0.311278124459133, "delta_h_icp_bits": -1.0}
    },
    {
      "id": "common_bijective_relabeling",
      "labels": ["alpha", "beta"],
      "p": [0.9, 0.1],
      "q": [0.5, 0.5],
      "expected": {"i_icp_bits": 0.146793102436052, "delta_h_icp_bits": 0.531004406410719}
    }
  ],
  "malformed_cases": [
    {
      "id": "length_mismatch",
      "labels": ["y0", "y1"],
      "p": [1.0],
      "q": [0.5, 0.5],
      "expected_error": "shape_mismatch"
    },
    {
      "id": "negative_probability",
      "labels": ["y0", "y1"],
      "p": [1.1, -0.1],
      "q": [0.5, 0.5],
      "expected_error": "invalid_probability"
    },
    {
      "id": "not_normalized",
      "labels": ["y0", "y1"],
      "p": [0.4, 0.4],
      "q": [0.5, 0.5],
      "expected_error": "not_normalized"
    },
    {
      "id": "duplicate_label",
      "labels": ["y0", "y0"],
      "p": [0.5, 0.5],
      "q": [0.5, 0.5],
      "expected_error": "duplicate_label"
    }
  ]
}
