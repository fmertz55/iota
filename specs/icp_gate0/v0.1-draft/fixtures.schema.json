{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iota.invalid/specs/icp-gate0-fixtures.schema.json",
  "title": "ICP Gate 0 semantic fixtures",
  "type": "object",
  "required": ["spec_version", "log_base", "arm_orientation", "absolute_tolerance", "cases", "malformed_cases"],
  "properties": {
    "spec_version": {"type": "string"},
    "log_base": {"const": 2},
    "arm_orientation": {
      "type": "object",
      "required": ["p", "q"],
      "properties": {
        "p": {"const": "natural_or_interaction_present"},
        "q": {"const": "matched_reference"}
      },
      "additionalProperties": false
    },
    "absolute_tolerance": {"type": "number", "exclusiveMinimum": 0},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/validCase"}
    },
    "malformed_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/malformedCase"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "baseCase": {
      "type": "object",
      "required": ["id", "labels", "p", "q"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "labels": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "p": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "q": {"type": "array", "items": {"type": "number"}, "minItems": 1}
      }
    },
    "validCase": {
      "allOf": [
        {"$ref": "#/$defs/baseCase"},
        {
          "type": "object",
          "required": ["expected"],
          "properties": {
            "expected": {
              "type": "object",
              "required": ["i_icp_bits", "delta_h_icp_bits"],
              "properties": {
                "i_icp_bits": {"type": "number", "minimum": 0, "maximum": 1},
                "delta_h_icp_bits": {"type": "number"}
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "malformedCase": {
      "allOf": [
        {"$ref": "#/$defs/baseCase"},
        {
          "type": "object",
          "required": ["expected_error"],
          "properties": {
            "expected_error": {
              "enum": ["shape_mismatch", "invalid_probability", "not_normalized", "duplicate_label"]
            }
          }
        }
      ]
    }
  }
}
